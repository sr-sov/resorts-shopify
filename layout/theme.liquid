<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    
    <title>{{ page_title }} - {{ shop.name }}</title>
    
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="{{ shop.name }} is a luxury eco-retreat in Laguna, Philippines. Book your stay and experience nature in our hot spring resort in Pansol, Calamba, and private pool eco-resort in San Pablo.">
    {% endif %}

    <meta name="keywords" content="resort in Pansol, hot spring resort Calamba, eco-resort San Pablo Laguna, private pool resort Laguna, luxury retreat Philippines">

    <!-- Open Graph tags for social sharing -->
    <meta property="og:title" content="{{ page_title }} - {{ shop.name }}">
    <meta property="og:description" content="{% if page_description %}{{ page_description | escape }}{% else %}{{ shop.name }} is a luxury eco-retreat in Laguna, Philippines. Experience nature in our hot spring resort in Pansol, Calamba, and private pool eco-resort in San Pablo.{% endif %}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ canonical_url }}">
    {% if page_image %}
      <meta property="og:image" content="{{ page_image | image_url: width: 1200 }}">
    {% else %}
      <meta property="og:image" content="{{ 'hero.png' | asset_url }}">
    {% endif %}

    <!-- Twitter Card tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_title }} - {{ shop.name }}">
    <meta name="twitter:description" content="{% if page_description %}{{ page_description | escape }}{% else %}Discover {{ shop.name }}, a luxury eco-retreat in Laguna, Philippines. Book your stay today.{% endif %}">
    {% if page_image %}
      <meta name="twitter:image" content="{{ page_image | image_url: width: 1200 }}">
    {% else %}
      <meta name="twitter:image" content="{{ 'hero.png' | asset_url }}">
    {% endif %}

    <!-- Structured Data (Schema.org) for LocalBusiness/Resort -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Resort",
      "name": "{{ shop.name }}",
      "description": "A luxury eco-retreat and hot spring resort located in Laguna, Philippines, offering private pools and nature experiences.",
      "url": "{{ shop.url }}",
      "telephone": "+63 (2) 8888-0000",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Eco-Retreat Drive",
        "addressLocality": "San Pablo",
        "addressRegion": "Laguna",
        "postalCode": "4000",
        "addressCountry": "PH"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 14.0700,
        "longitude": 121.3200
      },
      "amenityFeature": [
        {
          "@type": "LocationFeatureSpecification",
          "name": "Hot Spring",
          "value": true
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "Private Pool",
          "value": true
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "Eco-Retreat",
          "value": true
        }
      ],
      "image": "{{ 'hero.png' | asset_url }}"
    }
    </script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    {{ content_for_header }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    
    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
  </head>
  
  <body>
    <!-- Navigation -->
    <nav class="nav {% if template == 'index' %}nav-hero{% endif %}" id="nav">
      <div class="nav-inner">
        <a href="/" class="nav-logo">{{ shop.name }}</a>
        <div class="nav-links">
          <a href="/#rooms">Rooms</a>
          <a href="/#amenities">Amenities</a>
          <a href="/#experience">Experience</a>
          <a href="/cart" class="nav-cart-link">
            Your Cart <span>({{ cart.item_count }})</span>
          </a>
        </div>
        <a href="/collections/all" class="nav-cta">Book Now</a>
      </div>
    </nav>

    <main role="main" id="MainContent">
      {{ content_for_layout }}
    </main>

    <!-- Footer -->
    <footer class="footer" id="contact">
      <div class="footer-inner">
        <div class="footer-brand">
          <h3>{{ shop.name }}</h3>
          <p>Experience luxury eco-resort living surrounded by lush rainforest and crystal-clear rivers.</p>
        </div>
        <div>
          <h4>Explore</h4>
          <ul class="footer-links">
            <li><a href="/#rooms">Accommodations</a></li>
            <li><a href="/#amenities">Wellness & Dining</a></li>
            <li><a href="/#experience">Our Story</a></li>
          </ul>
        </div>
        <div>
          <h4>Contact</h4>
          <ul class="footer-links">
            <li><a href="mailto:info@{{ shop.domain }}">info@{{ shop.domain }}</a></li>
            <li><a href="#">+63 (2) 8888-0000</a></li>
            <li><a href="#">Palawan, Philippines</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.</p>
        <p>Design Demo</p>
      </div>
    </footer>

    <script>
      // Navbar scroll effect optimized for INP
      const nav = document.getElementById('nav');
      if (nav) {
        let isScrolling = false;

        const updateNav = () => {
          nav.classList.toggle('scrolled', window.scrollY > 80);
          isScrolling = false;
        };

        window.addEventListener('scroll', () => {
          if (!isScrolling) {
            window.requestAnimationFrame(updateNav);
            isScrolling = true;
          }
        }, { passive: true });

        // Initial check in case of page reload halfway down
        if (window.scrollY > 80) nav.classList.add('scrolled');
      }
    </script>
  </body>
</html>
